3 (fom 13704)))) (dkc (e25 0) (e25 1) (e25 8))) 40 (esn (e24 (e25 0)) (dkc (e25 6))) 38 (e25 5)) (e25 9)))) 36707139 (eud 194498170300000) \\\\\\\"com.bloks.www.async_action.fubs.open_consideration_page\\\\\\\" (f4i (dkc \\\\\\\"page_id\\\\\\\" \\\\\\\"entrypoint_surface\\\\\\\") (dkc (eud 1031261963407810) \\\\\\\"f2s_video\\\\\\\")) (f6m 6) \\\\\\\"long-live\\\\\\\" (f6m 6) (e24 1) (e24 1) (dkc))\\\"}}}\"}}}}}}}},\"video\":{\"id\":\"1551512176697814\",\"social_bubbles_metadata_v2_engagement_filters\":{\"edges\":[]},\"overlays\":[],\"creator_playlist\":null,\"video_imf_data\":null},\"soundtrack_info\":{\"contains_auto_attribution\":true},\"associated_dsc_deal\":null},\"supplemental_social_story\":null,\"message\":{\"text\":\"If Sun won't, he will. We all know what auroras are. They are the beautiful green northern lights in Earth's sky. Formed by the interaction of Sun's plasma and Earth's magnetic field. So why is there no auroras on our beloved Moon? Because it doesn't have a magnetic field, infact most moons lack it. Plus a magnetic field doesnt guarantee auroras. For all the reasons no Moon in solar system should have auroras but the moons of Jupiter does carry it because of the super intense magnetic field from their planet Jupiter. The planet releases heavily charged particles which travels to its moon through its magnetic field and brings beautiful auroras. What's surprising is, Jupiter's magnetic field is so huge it reaches upto Saturn.\",\"translation_type\":\"ORIGINAL\",\"ranges\":[]},\"explicit_place\":null,\"feedback\":{\"id\":\"ZmVlZGJhY2s6MTIyMTIyOTE0MDU2Nzc2ODc3\",\"legacy_api_post_id\":\"122122914056776877\",\"share_fbid\":\"122122914056776877\",\"media_igid\":null,\"viewer_feedback_reaction_info\":null,\"reactors\":{\"count\":16830},\"reaction_display_config\":{\"reaction_display_strategy\":\"NONE\"},\"unified_reactors\":{\"count\":16830},\"cross_universe_feedback_info\":{\"ig_comment_count\":null,\"ig_reaction_count\":null,\"is_pro_mode_or_additio