# ---------------------------------------------------------------------------
# What is tracked
#   Source code, tests, documentation, config templates and the small fixtures
#   listed in release-files.txt (the same list tools/export_source.py publishes).
#
# What is ignored
#   Runtime data, generated artifacts, historical evidence and local toolchains.
#   The classification and the reasoning live in
#   docs/backend-modernization/REPO_CLASSIFICATION.md — keep the two in sync.
# ---------------------------------------------------------------------------

# Local virtualenv and build caches
/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Service runtime state (machine-specific, recreated by the service)
/data/
/api-jobs/
/api-batches/
/runs/
/batches/
/transactions/
/share_users/
/exports/
/worker-bootstrap/
/fresh-export/
*.log
*.lock

# Probe / gate / diagnostic output written by the tools themselves
/anonymous-public-probe.json
/current-ui-probe.xml
/facebook-post-queue-smoke.state.json
/facebook-release-gate-state.json
/graphql-docids.json
/predeploy-validation.json
specs/**/*.tmp

# Generated artifacts and benchmark output
/dist/
/evidence/
/perf/results/

# Historical evidence and archives (kept on disk, not published)
/archive/
/backups/
/docs/archive/

# Local toolchains and patched binaries (platform specific, large)
/jre/
/lib/
/patched-libs/
/platform-tools/
/android-ui-dump-helper/build/
/android-ui-dump-helper/*.apk
/android-ui-dump-helper/*.idsig
/jadx-*.exe

# Local assistant/IDE state
/.waylog/
/.coding-tools/
/.serena/

# Local configuration and secrets
/facebook.local.json
/facebook_workers.json
/*.pem
/*.key
/*.der
*.keystore

# Large reference material that is not part of the published source tree
/SSL-Pinning-Bypass-ADB.pdf
/SSL-Pinning-Bypass-ADB.txt
