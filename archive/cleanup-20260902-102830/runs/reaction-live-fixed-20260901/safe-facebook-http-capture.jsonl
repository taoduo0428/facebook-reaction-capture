"debug_info\":null,\"cache_id\":\"-985265941564685778\",\"anonymous_profile_header_nt_action\":null,\"to\":{\"__typename\":\"Group\",\"strong_id__\":\"165764687379083\",\"id\":\"165764687379083\",\"profile_picture\":{\"uri\":\"https:\\/\\/scontent-hkg4-1.xx.fbcdn.net\\/v\\/t39.30808-6\\/464903318_3557801141018785_573536284033895947_n.jpg\",\"width\":120,\"height\":120},\"override_community_attribution_name\":null,\"name\":\"Science Squad\",\"is_multi_company_group\":false,\"parent_group\":null,\"is_forsale_group\":false,\"post_edit_approval_setting\":\"REQUIRE_APPROVAL\",\"if_viewer_can_see_sharesheet\":null,\"privacy_info\":{\"label\":{\"text\":\"\\u516c\\u5f00\"}},\"community_participation_questions\":[{\"id\":\"1017978865490990\",\"question\":\"What's the name of our sun?\"},{\"id\":\"1017979512157592\",\"question\":\"How discovered radium?\"},{\"id\":\"1017979695490907\",\"question\":\"Explain why your post is important for this group.\"}],\"viewer_forum_join_state\":\"CAN_JOIN\",\"viewer_admin_type\":\"NONE\",\"should_denudge_group_join_ctas\":false,\"can_viewer_see_community_messaging\":false,\"disclosure_on_content_sharesheet\":null,\"group_flairs\":[],\"if_viewer_can_create_share_exp_tracking\":null,\"navigation_info\":{\"destination\":{\"__typename\":\"Group\",\"strong_id__\":\"165764687379083\"}}},\"subtitle\":null,\"actors\":[{\"__typename\":\"User\",\"strong_id__\":\"100047126350934\",\"id\":\"100047126350934\",\"friendship_status\":\"CANNOT_REQUEST\",\"gender\":\"MALE\",\"name\":\"Hashem Al-Ghaili\",\"profile_picture\":{\"uri\":\"https:\\/\\/scontent-hkg4-1.xx.fbcdn.net\\/v\\/t39.30808-1\\/470211694_1113705380210330_7316031854910047619_n.jpg\",\"width\":120,\"height\":120},\"story_bucket\":{\"nodes\":[{\"id\":\"154189812828563\",\"is_bucket_seen_by_viewer\":true,\"is_bucket_owned_by_viewer\":false,\"camera_post_type\":\"ADMINED_ADDITIONAL_PROFILE_STORY\",\"threads\":{\"is_empty\":true},\"latest_thread_creation_time\":1786750853,\"should_show_close_friend_badge\":false}]},\"conversation_starter_owner_bucket\":{\"nodes\":[]},\"fubs_creator_info\":null,\"fubs_creator\":null,\"is_additional_profile_plus\":true,\"delegate_page\":{\"id\":\"693504594115135\",\"is_business_page_active\":false,\"whatsapp_presence\":false},\"is_work_user\":false,\"work_foreign_entity_info\":null,\"work_info\":null,\"is_verified\":true,\"subscribe_status\":\"CAN_SUBSCRIBE\",\"secondary_subscribe_status\":\"REGULAR_FOLLOW\",\"short_name\":\"Hashem Al-Ghaili\",\"is_favorite\":false,\"is_page_or_profile_plus_actor\":true,\"url\":\"https:\\/\\/m.facebook.com\\/ScienceNaturePage\",\"is_subscriber_only_live_teaser\":false,\"is_currently_live\":false,\"currently_live_video\":null,\"profile_navigation_info\":{\"glimmer_state\":\"SMALL_COVER_PHOTO_PROFILE_PICTURE_ROUNDED_CORNERS_GLIMMER\",\"landing_tab\":null},\"is_viewer_friend\":false,\"should_inline_comment_composer_for_new_user\":false}],\"creation_time\":1788037210,\"backdated_time\":null,\"url\":\"https:\\/\\/m.facebook.com\\/groups\\/sciencesquadgroup\\/permalink\\/2059054854716714\",\"display_time_block_info\":null,\"titleFromRenderLocation\":null,\"feed_mobile_title\":null,\"message_markdown_html\":null,\"message_richtext\":[],\"message_richtext_with_keywords\":[],\"message\":{\"text\":\"80\\u0025 of Americans in their 20s already have signs of heart disease \\u2014 and experts say excessive obesity is to blame. \\n\\nA groundbreaking study published in \\u201cCirculation: Population Health and Outcomes\\u201d has revealed a startling health reality for young Americans: youth is no longer a shield against heart disease. \\n\\nResearchers analyzing a diverse cohort of 1,283 young adults with an average age of 23 found that nearly eight in ten participants met the criteria for cardiovascular-kidney-metabolic (CKM) syndrome. \\n\\nThis syndrome represents a dangerous trifecta where excess body fat, elevated blood sugar, high blood pressure, and suboptimal kidney function act in concert, laying the silent groundwork for future cardiovascular crises long before clinical symptoms appear.\\n\\nUsing advanced carotid ultrasound imaging, scientists observed that as participants advanced through CKM syndrome stages, their artery walls showed significant thickening and early signs of subclinical damage.\\n\\n In fact, some 23-year-olds displayed arterial measurements typically expected in individuals in their mid-thirties. Experts emphasize that these findings challenge the long-held assumption that cardiovascular health is a concern exclusively for middle age. Instead, they underscore the urgent need for routine cardiovascular screenings to begin decades earlier, allowing young adults to intervene with lifestyle and medical changes before permanent damage is done.\\n\\nsource: Krishnan, V., & Lloyd-Jones, D. (2026). Cardiovascular-Kidney-Metabolic Syndrome and Early Arterial Injury in Young Adults. Circulation: Population Health and Outcomes.\",\"ranges\":[],\"delight_ranges\":[],\"image_ranges\":[]},\"suffix\":null,\"has_minutiae_action\":false,\"post_id\":\"2059054854716714\",\"can_viewer_manage_collaborators_and_invites\":false,\"can_viewer_remove_self_from_creator_collaboration\":false,\"collaborators\":[],\"privacy_label\":\"\\u516c\\u5f00\",\"xposted_destination_apps\":[],\"cxp_content_destination_metadata\":null,\"cxp_downstream_use_xpost_metadata\":{\"ig_downstream_use_xpost_metadata_response\":{\"downstream_use_xpost_deny_reason\":\"NONE\"}},\"privacy_scope\":{\"privacy_write_id\":\"cHJpdmFjeV9zY29wZV9yZW5kZXJlcjp7ImlkIjoyMDU5MDU0ODU0NzE2NzE0fQ\",\"label\":\"\\u516c\\u5f00\\u5c0f\\u7ec4\",\"description\":\"\\u516c\\u5f00\\u5c0f\\u7ec4\",\"type\":\"everyone\",\"icon\":{\"uri\":\"https:\\/\\/static.xx.fbcdn.net\\/rsrc.php\\/yW\\/r\\/sG68L5vspEB.web\",\"name\":\"everyone\"},\"can_viewer_edit\":false,\"education_info\":{\"reshare_education_info\":null,\"tag_expansion_education\":{\"eligible_for_education\":false,\"show_active_education\":true,\"education_co